# Pages: browsers must check for a newer copy every visit (Safari otherwise keeps
# old pages for days, which also keeps the old ?v= CSS/JS links). Unchanged pages
# still load from the browser's copy after a quick "not modified" reply.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Security: HTTPS only for a year, no content-type guessing, no framing by other sites,
  # minimal referrer, no camera/mic/location, and only this site's own files may load.
  # (Inline scripts/styles are allowed because the pages use them.)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always unset X-Powered-By
</IfModule>

# Clean URLs: /portfolio/shell_house instead of /portfolio/shell_house.html
Options -MultiViews -Indexes

# "portfolio" is both a page (portfolio.html) and a folder (portfolio/),
# so don't let the server force a trailing slash before our rules run
DirectorySlash Off

RewriteEngine On

# 0a) www.tikamuk.design -> tikamuk.design (one address for Google, not two copies)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# 0b) Hidden files (.gitignore, .git, .htaccess) are never served; .well-known stays open for SSL checks
RewriteRule (^|/)\.(?!well-known/) - [F]

# 1) /index.html -> folder URL (e.g. /dev1/index.html -> /dev1/)
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 2) /page.html -> /page (only for requests typed/clicked by the browser)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 3) /page/ -> /page (a trailing slash would break the pages' relative CSS/image paths)
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteCond %{DOCUMENT_ROOT}%1.html -f
RewriteRule ^ %1 [R=301,L]

# 4) /page -> serve page.html behind the scenes
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# 5) Real folders still get their trailing slash (since DirectorySlash is off)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ %{REQUEST_URI}/ [R=301,L]
